From 31c12979c77a46a401553e147e4a1376fef8e84f Mon Sep 17 00:00:00 2001
From: HaramBlur Contributor <contributor@example.com>
Date: Sun, 18 Oct 2026 16:28:10 +0000
Subject: [PATCH 3/6] fix(whitelist): robust hostname matching with subdomain
 support

The old pattern hostname.split("www.")?.[1] stripped everything before
the FIRST occurrence of 'www.' anywhere in the hostname, corrupting
hosts like sub.www.example.com, and never matched subdomains.

normalizeHostname() now strips only a leading 'www.' (lowercased,
trimmed), and isWhitelisted() matches an entry against the exact
hostname or any of its subdomains. Entries stored by older versions
(possibly with a leading www.) keep working since both sides are
normalized.
---
 src/content.js          |  8 ++------
 src/modules/helpers.js  | 30 ++++++++++++++++++++++++++++++
 src/modules/settings.js |  7 ++-----
 3 files changed, 34 insertions(+), 11 deletions(-)

diff --git a/src/content.js b/src/content.js
index e671972..172803b 100644
--- a/src/content.js
+++ b/src/content.js
@@ -3,6 +3,7 @@ import {
     initMutationObserver,
     killObserver,
 } from "./modules/observers";
+import { isWhitelisted } from "./modules/helpers";
 import Settings from "./modules/settings";
 import { attachStyleListener } from "./modules/style";
 
@@ -25,12 +26,7 @@ if (window.self === window.top) {
     Settings.init()
         .then((settings) => {
             if (
-                settings
-                    .getWhitelist()
-                    .includes(
-                        window.location.hostname?.split("www.")?.[1] ??
-                            window.location.hostname
-                    )
